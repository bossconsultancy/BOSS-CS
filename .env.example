# Required: your OpenAI API key (keep it secret; set it in Vercel > Settings > Environment Variables)
OPENAI_API_KEY=

# Required for a public site: everyone who opens the app must enter this password
APP_PASSWORD=

# Optional: change the OpenAI models without touching the code
OPENAI_TEXT_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# low | medium | high (higher = better photo, costs more)
OPENAI_IMAGE_QUALITY=high
